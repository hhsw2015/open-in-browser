{
  "manifest_version": 3,
  "name": "Open In Browser Apps",
  "version": "0.1.0",
  "description": "Send current tab URL to local automation APIs.",
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Open Current Page",
    "default_popup": "popup.html"
  }
}
